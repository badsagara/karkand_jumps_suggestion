{
  // Cloudflare Worker serving the Karkand jump map.
  //
  //   public/   static files, served by the assets binding
  //   worker.js router for /api/save and /api/suggest
  //
  // Secrets (GITHUB_TOKEN, TURNSTILE_SECRET) and the other variables are set
  // in the dashboard under Settings → Variables and Secrets, not here.
  "name": "karkandjumps",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
